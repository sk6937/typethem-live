<!DOCTYPE html>
<html>
	<head>
		<title>Redirecting...</title>
							<meta http-equiv="refresh" content="0;url=https://typethem.com/">
				</head>
	<body>
							<script type="text/javascript">
					window.location.assign("https:\/\/typethem.com\/");
				</script>
			
							<p>You are being redirected to <a href="https://typethem.com/">https://typethem.com/</a></p>
				</body>
</html>
